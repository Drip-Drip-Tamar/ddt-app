{
    "name": "astro-sanity-starter",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "export": "npm run backup:sanity",
        "backup:sanity": "node ./scripts/sanity-backup.mjs",
        "test": "vitest run",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "test:e2e": "playwright test",
        "serve:test": "netlify serve --port 4173",
        "lint": "eslint .",
        "typecheck": "astro check && tsc --noEmit",
        "typegen:extract": "cd studio && npx sanity schemas extract --enforce-required-fields --path schema.json",
        "typegen:generate": "cd studio && npx sanity typegen generate",
        "typegen": "npm run typegen:extract && npm run typegen:generate",
        "typegen:check": "npm run typegen && git diff --exit-code -- src/sanity.types.ts studio/schema.json",
        "test:all": "npm run lint && npm run typecheck && npm run typegen:check && npm run build && npm run test:coverage",
        "check:node": "node ./scripts/check-node-version.mjs",
        "check:prod": "npm run check:node && npm ci && npm --prefix studio ci && npm run test:all && npm --prefix studio run build"
    },
    "engines": {
        "node": ">=22.18.0 <23"
    },
    "dependencies": {
        "@astrojs/netlify": "^8.1.2",
        "@astrojs/react": "^6.0.1",
        "@fontsource-variable/mulish": "^5.2.8",
        "@portabletext/to-html": "^5.0.2",
        "@sanity/astro": "^3.5.0",
        "@sanity/client": "^7.14.1",
        "@sanity/image-url": "^2.0.3",
        "@sanity/preview-url-secret": "^4.1.2",
        "@sanity/validation": "^3.14.4",
        "@sanity/visual-editing": "^5.2.1",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.1.3",
        "astro-icon": "^1.1.0",
        "chart.js": "^4.5.0",
        "chartjs-plugin-annotation": "^3.1.0",
        "dotenv": "^17.2.4",
        "groq": "^5.8.1",
        "leaflet": "^1.9.4",
        "marked": "^17.0.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-is": "^19.2.6",
        "sanity": "^5.24.0",
        "styled-components": "^6.3.8",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/typography": "^0.5.20",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.2",
        "@types/leaflet": "^1.9.21",
        "@types/react": "^19.2.13",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.10",
        "daisyui": "^5.5.18",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^1.3.1",
        "jsdom": "^28.0.0",
        "netlify-cli": "^27.0.0",
        "typescript": "^5.9.2",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    }
}
