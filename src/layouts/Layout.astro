---
import { type SiteConfig, type CustomImage } from 'types';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import { VisualEditing } from '@sanity/astro/visual-editing';
import { fetchData } from '@data/siteConfig';
import { getImageUrl, isSanityImage } from '@utils/sanity-image';
import { canonicalUrl } from '@utils/canonical-url';

import '../styles/globals.css';

interface Props {
    title: string;
    addTitleSuffix?: boolean;
    includeCanonical?: boolean;
    noIndex?: boolean;
    description?: string;
    image?: CustomImage;
    article?: { title: string; publishedAt?: string; author?: { name: string } };
}

const { addTitleSuffix, includeCanonical = true, noIndex = false, image, article } = Astro.props;
const description = Astro.props.description?.trim() || 'Drip Drip Tamar is a community project monitoring water quality and caring for the River Tamar near Calstock.';

const configData: SiteConfig = (await fetchData(Astro.locals.sanityClient)) || {};
const titleSuffix = configData.titleSuffix && addTitleSuffix !== false ? configData.titleSuffix : undefined;
const title = [Astro.props.title, titleSuffix].filter(Boolean).join(' | ');

// Generate optimized URL for social sharing (1200x630 is standard OG image size)
let resolvedImage: { src: string } | undefined;
const socialImage = image || configData.header?.logo;
const siteBase = Astro.site ?? Astro.url.origin;
if (socialImage) {
    const sanitySource = socialImage.asset || socialImage.src;
    if (isSanityImage(sanitySource)) {
        const optimizedUrl = getImageUrl(sanitySource, image ? 1200 : 600, { height: image ? 630 : undefined, quality: 80 });
        resolvedImage = { src: new URL(optimizedUrl, siteBase).toString() };
    } else if (socialImage.src) {
        resolvedImage = { src: new URL(socialImage.src, siteBase).toString() };
    }
}
const canonicalURL = includeCanonical ? canonicalUrl(Astro.url, Astro.site) : undefined;
const articleData = article && canonicalURL ? {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description,
    mainEntityOfPage: canonicalURL,
    datePublished: article.publishedAt,
    author: article.author ? { '@type': 'Person', name: article.author.name } : undefined,
    image: image ? resolvedImage?.src : undefined
} : undefined;
---

<!doctype html>
<html lang="en" data-theme="light">
    <head>
        <!-- High Priority Global Metadata -->
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>{title}</title>
        <meta name="generator" content={Astro.generator} />

        <!-- Low Priority Global Metadata -->
        {configData.favicon?.src && <link rel="icon" type="image/svg+xml" href={configData.favicon.src} />}
        <link rel="sitemap" href="/sitemap.xml" />

        <!-- Page Metadata -->
        {canonicalURL && <link rel="canonical" href={canonicalURL} />}
        {(noIndex || Astro.locals.isPreview) && <meta name="robots" content="noindex" />}
        <meta name="description" content={description} />

        <!-- Open Graph / Facebook -->
        {canonicalURL && <meta property="og:url" content={canonicalURL} />}
        <meta property="og:type" content={article ? 'article' : 'website'} />
        <meta property="og:site_name" content={configData.header?.title || 'Drip Drip Tamar'} />
        <meta property="og:locale" content="en_GB" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {resolvedImage?.src && <meta property="og:image" content={resolvedImage.src} />}
        {resolvedImage?.src && <meta property="og:image:alt" content={socialImage?.alt || configData.header?.title || 'Drip Drip Tamar'} />}
        {article?.publishedAt && <meta property="article:published_time" content={article.publishedAt} />}

        <!-- X/Twitter -->
        <meta property="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
        {canonicalURL && <meta property="twitter:url" content={canonicalURL} />}
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        {resolvedImage?.src && <meta property="twitter:image" content={resolvedImage.src} />}
        {resolvedImage?.src && <meta property="twitter:image:alt" content={socialImage?.alt || configData.header?.title || 'Drip Drip Tamar'} />}
        {articleData && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleData).replace(/</g, '\\u003c')} />}
    </head>
    <body class="antialiased">
        <a class="skip-link" href="#main-content">Skip to content</a>
        <Header {...configData.header} />
        <main id="main-content" tabindex="-1">
            <slot />
        </main>
        <Footer {...configData.footer} />
        <VisualEditing enabled={Astro.locals.isPreview} />
    </body>
</html>
