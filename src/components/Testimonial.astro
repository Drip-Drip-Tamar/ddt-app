---
import { marked } from 'marked';
import { type Testimonial } from 'types';
import ResponsiveImage from '@components/ResponsiveImage.astro';

interface Props extends Testimonial {
    class?: string;
}

const { quote, author, theme, hasBorder, class: className } = Astro.props;
---

<div
    class:list={['card', hasBorder !== false && 'card-border', 'w-full max-w-2xl', className]}
    {...theme && theme !== 'transparent' && { 'data-theme': theme }}
>
    <div class="text-left card-body">
        {
            author?.company && (
                <div class="mb-4 font-bold">
                    {(author.company?.logo?.asset || author.company?.logo?.src) ? (
                        <ResponsiveImage
                            src={author.company.logo.src}
                            asset={author.company.logo.asset}
                            dimensions={author.company.logo.dimensions}
                            alt={author.company.logo.alt}
                            class="max-w-24"
                            imageType="logo"
                        />
                    ) : (
                        <span>{author.company.name}</span>
                    )}
                </div>
            )
        }
        {quote && <blockquote class="text-lg sm:text-xl" set:html={marked.parse(quote)} />}
        {
            author && (
                <div class="flex flex-col gap-4 mt-4">
                    <div class="font-bold">
                        <!-- prettier-ignore -->
                        <span>{author.name}</span>{author.title && (<>{', '}<span>{author.title}</span></>)}
                    </div>

                    {(author.image?.asset || author.image?.src) && (
                        <div class="w-20 overflow-hidden rounded-full aspect-square">
                            <ResponsiveImage
                                src={author.image.src}
                                asset={author.image.asset}
                                dimensions={author.image.dimensions}
                                alt={author.image.alt}
                                class="object-cover w-full h-full"
                                imageType="avatar"
                            />
                        </div>
                    )}
                </div>
            )
        }
    </div>
</div>
