---
import Section from '@components/Section.astro';
import type { Section as SectionType } from 'types';
import { getPrimaryLocation } from '@data/locationConfig.js';

export interface Props extends SectionType {
    centre?: { lat: number; lon: number };
    radiusKm?: number;
    days?: number;
    api?: string;
    class?: string;
    'data-sb-field-path'?: string;
}

// Get location configuration from Sanity
const location = await getPrimaryLocation();
const defaultCentre = { lat: location.center.lat, lon: location.center.lng };

const { centre = defaultCentre, radiusKm = location.defaultRadius, days = 5, api = '/api/cso.json', class: className, ...sectionProps } = Astro.props;

// Generate unique ID for map
const mapId = `cso-map-${Math.random().toString(36).substring(2, 11)}`;
---

<Section {...sectionProps} class={className}>
    <div class="cso-map-container">
        <!-- Map Container -->
        <div class="bg-base-100 rounded-lg shadow-lg overflow-hidden">
            <!-- Map Header -->
            <div class="p-4 md:p-6 pb-0">
                <div class="flex items-start justify-between mb-3">
                    <div>
                        <h4 class="text-lg font-semibold mb-1">Storm Overflow Locations</h4>
                        <p class="text-xs text-base-content/60">
                            Live monitoring within {radiusKm}km radius • Updated ~10 min
                        </p>
                    </div>
                    <div id={`${mapId}-status`} class="badge badge-lg badge-ghost">Loading...</div>
                </div>

                <!-- Legend -->
                <div class="flex flex-wrap gap-3 mb-3 text-xs">
                    <div class="flex items-center gap-1.5 px-2 py-1 bg-red-50 rounded-full">
                        <span class="w-3 h-3 rounded-full bg-red-500 shadow-sm"></span>
                        <span class="font-medium text-red-900">⚠️ Active</span>
                    </div>
                    <div class="flex items-center gap-1.5 px-2 py-1 bg-amber-50 rounded-full">
                        <span class="w-3 h-3 rounded-full bg-amber-500 shadow-sm"></span>
                        <span class="font-medium text-amber-900">⚡ Recent (≤{days} days)</span>
                    </div>
                    <div class="flex items-center gap-1.5 px-2 py-1 bg-gray-50 rounded-full">
                        <span class="w-3 h-3 rounded-full bg-gray-500 shadow-sm"></span>
                        <span class="font-medium text-gray-700">✓ Inactive</span>
                    </div>
                </div>

                <!-- Warning about map validity and data freshness -->
                <div class="alert alert-warning mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                        ></path>
                    </svg>
                    <span> This map is for general guidance only. Always check local conditions and official sources before water activities. </span>
                </div>

                <!-- Map Element -->
                <div
                    id={mapId}
                    class="cso-leaflet-map"
                    style="height: 500px; width: 100%;"
                    data-cso-map
                    data-lat={centre.lat}
                    data-lon={centre.lon}
                    data-radius={radiusKm}
                    data-days={days}
                    data-api={api}
                    data-name={location.name}
                    aria-label={`Interactive map showing storm overflow locations within ${radiusKm}km of ${location.name}`}
                >
                </div>
            </div>

            <!-- Data source notice (hidden by default) -->
            <div id={`${mapId}-notice`} class="alert alert-info mt-4 hidden">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>
                    Live data currently unavailable. Showing CSO locations with 2023 historical statistics. Check <a
                        href="https://www.southwestwater.co.uk/environment/rivers-and-bathing-waters/waterfitlive/"
                        target="_blank"
                        rel="noopener"
                        class="link">WaterFit Live</a
                    > for latest updates.
                </span>
            </div>

            <!-- Attribution -->
            <div class="mt-6 pt-3 border-t border-base-300">
                <p class="text-xs text-base-content/60">
                    Data: <a href="https://theriverstrust.org/key-issues/sewage-in-rivers" target="_blank" rel="noopener noreferrer" class="link link-hover">
                        Rivers Trust EDM 2023
                    </a> +
                    <a
                        href="https://www.southwestwater.co.uk/environment/rivers-and-bathing-waters/waterfitlive/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link link-hover"
                    >
                        South West Water
                    </a> • CC BY 4.0 • Map: © <a
                        href="https://www.openstreetmap.org/copyright"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link link-hover"
                    >
                        OpenStreetMap
                    </a> contributors
                </p>
            </div>

            <!-- Error message (hidden by default) -->
            <div id={`${mapId}-error`} class="alert alert-warning mt-4 hidden">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                    ></path>
                </svg>
                <span>CSO data unavailable — try again shortly.</span>
            </div>

            <noscript>
                <div class="alert alert-warning mt-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                        ></path>
                    </svg>
                    <span>JavaScript is required to view the interactive map.</span>
                </div>
            </noscript>
        </div>
    </div>

    <script>
        import { registerStormOverflowMaps } from '../scripts/charts/storm-overflow-map';

        registerStormOverflowMaps();
    </script>

    <style>
        .cso-map-container {
            max-width: 100%;
        }

        .cso-leaflet-map {
            background: #e5e7eb;
            position: relative;
        }

        :global(.leaflet-container) {
            font-family: inherit;
        }

        :global(.leaflet-popup-content-wrapper) {
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        :global(.leaflet-popup-content) {
            margin: 12px;
            font-size: 14px;
        }

        @media (max-width: 640px) {
            .cso-leaflet-map {
                height: 400px !important;
            }
        }
    </style>
</Section>
