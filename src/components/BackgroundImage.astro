---
import { type BackgroundImage } from 'types';
import ResponsiveImage from '@components/ResponsiveImage.astro';

interface Props extends BackgroundImage {
    fit?: 'cover' | 'contain' | 'fill';
    loading?: 'eager' | 'lazy';
}

const { image, opacity, fit = 'cover', loading = 'lazy' } = Astro.props;
const fitClasses = { cover: 'object-cover', contain: 'object-contain', fill: 'object-fill' };
---

{image && (
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true" style={{ opacity: (opacity ?? 100) * 0.01 }}>
        <ResponsiveImage
            {...image}
            alt=""
            sizes="100vw"
            imageType="hero"
            loading={loading}
            fetchpriority={loading === 'eager' ? 'high' : 'auto'}
            class={`absolute inset-0 h-full w-full object-center ${fitClasses[fit]}`}
        />
    </div>
)}
