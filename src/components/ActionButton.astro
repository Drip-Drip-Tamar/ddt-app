---
import { type ActionButton } from 'types';

interface Props extends ActionButton {
    class?: string;
    'aria-current'?: 'page';
}

const { label, ariaLabel, url, theme, target, class: className, 'aria-current': ariaCurrent } = Astro.props;

const themeClassMap = {
    primary: 'btn-primary',
    secondary: 'btn-secondary',
    accent: 'btn-accent',
    neutral: 'btn-neutral'
};
---

{
    url ? (
        <a class:list={['btn', themeClassMap[theme || 'primary'], className]} href={url} target={target || '_self'} rel={target === '_blank' ? 'noopener noreferrer' : undefined} aria-label={ariaLabel} aria-current={ariaCurrent}>
            <span>{label}</span>
        </a>
    ) : (
        <button class:list={['btn', themeClassMap[theme || 'primary'], className]} aria-label={ariaLabel}>
            <span>{label}</span>
        </button>
    )
}
