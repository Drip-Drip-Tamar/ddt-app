---
import { Image } from 'astro:assets';
import type { SanityImageSource } from '@sanity/image-url';
import { 
    generateSrcSet, 
    defaultSizes, 
    isSanityImage,
    getImageUrl 
} from '@utils/sanity-image';

interface Props {
    src?: string;
    asset?: SanityImageSource;
    width?: number;
    height?: number;
    dimensions?: {
        width: number;
        height: number;
    };
    alt?: string;
    class?: string;
    sizes?: string;
    loading?: 'lazy' | 'eager';
    fetchpriority?: 'high' | 'low' | 'auto';
    imageType?: 'card' | 'hero' | 'logo' | 'avatar' | 'custom';
}

const {
    src,
    asset,
    width,
    height,
    dimensions,
    alt,
    class: className,
    sizes,
    loading = 'lazy',
    fetchpriority = 'auto',
    imageType = 'custom'
} = Astro.props;

// Determine if this is a Sanity image - prioritize asset over src
const sanitySource = asset || src;
const isSanity = isSanityImage(sanitySource);

// For non-Sanity images, ensure we have a valid src
const hasValidSrc = !isSanity && src;

// Get dimensions - use appropriate defaults based on imageType
const getDefaultDimensions = (type: string) => {
    switch(type) {
        case 'logo':
            return { width: 200, height: 80 }; // Reasonable logo dimensions
        case 'avatar':
            return { width: 150, height: 150 };
        default:
            return { width: 800, height: 600 };
    }
};

const defaults = getDefaultDimensions(imageType);
const imgWidth = width || dimensions?.width || defaults.width;
const imgHeight = height || dimensions?.height || defaults.height;

// Generate responsive image props for Sanity images
const responsiveSizes = isSanity ? (sizes || (imageType !== 'custom' && defaultSizes[imageType]) || '100vw') : undefined;
const widths = imageType === 'logo' || imageType === 'avatar' ? [64, 96, 128, 192, 256, 320] : undefined;
const srcSet = isSanity ? generateSrcSet(sanitySource, widths) : undefined;
const defaultSrc = isSanity ? getImageUrl(sanitySource, Math.min(imgWidth, 1920)) : undefined;

// Format for non-Sanity images
const format = hasValidSrc && src?.includes('.svg') ? 'svg' : 'webp';

// Only render if we have a valid source
const shouldRender = isSanity ? (sanitySource && defaultSrc) : hasValidSrc;
---

{shouldRender ? (
    !isSanity && src ? (
        <Image
            src={src}
            width={imgWidth} 
            height={imgHeight} 
            alt={alt || ''} 
            format={format} 
            class:list={className}
            loading={loading}
            fetchpriority={fetchpriority}
            decoding="async"
        />
    ) : (
        <img
            src={defaultSrc}
            srcset={srcSet}
            sizes={responsiveSizes}
            width={imgWidth}
            height={imgHeight}
            alt={alt || ''}
            class={className}
            loading={loading}
            fetchpriority={fetchpriority}
            decoding="async"
        />
    )
) : null}
