---
import { marked } from 'marked';
import { type Footer } from 'types';

interface Props extends Footer {}

const { text } = Astro.props;
---

{
    text && (
        <footer class="px-5 py-10 sm:px-8 sm:py-12 bg-base-200 border-t border-base-content/10">
            <div class="mx-auto text-center text-sm max-w-7xl markdown" set:html={marked.parse(text)} />
        </footer>
    )
}
