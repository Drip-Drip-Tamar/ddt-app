---
import { type ActionLink } from 'types';

interface Props extends ActionLink {
    class?: string;
    'aria-current'?: 'page';
}

const { label, ariaLabel, url, target, class: className, 'aria-current': ariaCurrent } = Astro.props;
---

{
    url ? (
        <a class:list={['text-base-content', className]} href={url} target={target || '_self'} rel={target === '_blank' ? 'noopener noreferrer' : undefined} aria-label={ariaLabel} aria-current={ariaCurrent}>
            <span>{label}</span>
        </a>
    ) : (
        <button class:list={['text-base-content', className]} aria-label={ariaLabel}>
            <span>{label}</span>
        </button>
    )
}
