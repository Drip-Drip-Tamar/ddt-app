---
import type { LogosSection } from 'types';
import ResponsiveImage from '@components/ResponsiveImage.astro';

interface Props {
    items: LogosSection['items'];
    class?: string;
}

const { items = [], class: className } = Astro.props;
---

<div class:list={['flex flex-wrap items-center justify-center gap-8', className]}>
    {
        items.map((logo) => {
            return (logo.asset || logo.src) ? (
                <ResponsiveImage
                    src={logo.src}
                    asset={logo.asset}
                    dimensions={logo.dimensions}
                    alt={logo.alt}
                    imageType="logo"
                />
            ) : null;
        })
    }
</div>
