---
import type { Section } from 'types';
import BackgroundImage from '@components/BackgroundImage.astro';

interface Props extends Section {
    class?: string;
    height?: 'small' | 'medium' | 'large' | 'full';
    backgroundImageFit?: 'cover' | 'contain' | 'fill';
    backgroundImageLoading?: 'eager' | 'lazy';
}

const { backgroundImage, theme, width, class: className, height = 'medium', backgroundImageFit = 'cover', backgroundImageLoading = 'lazy' } = Astro.props;

// Define height classes based on the height prop
const heightClasses = {
    small: 'py-8 sm:py-12',
    medium: 'py-12 sm:py-16',
    large: 'py-24 sm:py-32',
    full: 'min-h-screen py-16'
};
---

{
    width === 'inset' ? (
        <section class="w-full px-5 sm:px-8" data-width="inset">
            <div class:list={['relative mx-auto overflow-hidden max-w-7xl rounded-box', heightClasses[height], className]} data-theme={theme || 'light'}>
                {backgroundImage && <BackgroundImage {...backgroundImage} fit={backgroundImageFit} loading={backgroundImageLoading} />}
                <div class="relative px-5 sm:px-8 mx-auto">
                    <slot />
                </div>
            </div>
        </section>
    ) : (
        <section class:list={['relative w-full px-5 sm:px-8', heightClasses[height], className]} data-theme={theme || 'light'}>
            {backgroundImage && <BackgroundImage {...backgroundImage} fit={backgroundImageFit} loading={backgroundImageLoading} />}
            <div class="relative mx-auto max-w-7xl">
                <slot />
            </div>
        </section>
    )
}

<style>
    @reference "../styles/globals.css";
    section[data-width='inset'] + section,
    section + section[data-width='inset'] {
        @apply mt-8 sm:mt-16;
    }
</style>
