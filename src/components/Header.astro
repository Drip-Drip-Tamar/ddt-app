---
import { type Header } from 'types';
import Action from '@components/Action.astro';
import ResponsiveImage from '@components/ResponsiveImage.astro';

interface Props extends Header {}

const { title, logo, navLinks } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (url?: string) => {
    const path = url?.replace(/\/$/, '') || '/';
    return !!url && (currentPath === path || (path !== '/' && currentPath.startsWith(`${path}/`)));
};
---

<header class="relative z-20 border-b border-base-content/10 bg-base-100 px-5 py-3 sm:px-8">
    <nav aria-label="Main navigation" class="flex items-center justify-between w-full gap-6 mx-auto max-w-7xl">
        {
            logo?.asset || logo?.src ? (
                <a
                    class="flex min-w-0 items-center gap-3"
                    href="/"
                >
                    <ResponsiveImage
                        src={logo.src}
                        asset={logo.asset}
                        dimensions={logo.dimensions}
                        alt=""
                        imageType="logo"
                        loading="eager"
                        sizes="56px"
                        class="h-16 w-14 shrink-0 object-contain"
                    />
                    <span class="text-lg font-extrabold leading-tight">{title || 'Drip Drip Tamar'}</span>
                </a>
            ) : (
                <a
                    class="text-xl font-bold sm:text-2xl"
                    href="/"
                >
                    {title}
                </a>
            )
        }
        {
            navLinks && navLinks.length > 0 && (
                <>
                    <ul class="hidden lg:flex lg:flex-wrap lg:items-center lg:gap-1">
                        {navLinks.map((item) => (
                            <li>
                                <Action
                                    action={item}
                                    aria-current={isCurrent(item.url) ? 'page' : undefined}
                                    class:list={[item._type === 'actionLink' ? 'inline-flex items-center min-h-11 px-3 py-2 rounded-lg no-underline hover:bg-base-200' : 'px-4 py-3 h-auto min-h-0']}
                                />
                            </li>
                        ))}
                    </ul>
                    <div class="relative shrink-0 lg:hidden">
                        <button
                            class="inline-flex size-[44px] justify-center items-center relative z-2 nav-toggle"
                            aria-label="Open Menu"
                            aria-expanded="false"
                            aria-controls="nav-panel"
                        >
                            <span class="nav-toggle-icon" />
                        </button>
                        <div
                            id="nav-panel"
                            class="nav-panel absolute rounded-box -top-2 -right-2 z-1 shadow-xl bg-base-100 border border-base-200/70"
                        >
                            <ul class="flex flex-col px-4 pb-6 pt-14">
                                {navLinks.map((item) => (
                                    <li>
                                        <Action
                                            action={item}
                                            aria-current={isCurrent(item.url) ? 'page' : undefined}
                                            class:list={[
                                                item._type === 'actionLink' ? 'flex items-center min-h-11 px-3 py-2 rounded-lg no-underline hover:bg-base-200' : 'w-full px-4 py-3.5 h-auto min-h-0'
                                            ]}
                                        />
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </div>
                </>
            )
        }
    </nav>
</header>

<style>
    @reference "../styles/globals.css";
    nav :global([aria-current='page']) {
        font-weight: 800;
        text-decoration: underline;
        text-underline-offset: 0.3em;
    }
    .nav-panel {
        @apply max-w-72 opacity-0 scale-90 origin-top-right invisible;
        width: calc(100vw - 1rem);
        max-height: calc(100dvh - 2rem);
        overflow-y: auto;
        transition:
            transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .nav-panel.is-visible {
        @apply scale-100 opacity-100 visible;
    }
    .nav-panel li + li:has(.btn),
    .nav-panel li:has(.btn) + li {
        @apply mt-4;
    }
    .nav-toggle-icon {
        @apply block relative bg-current rounded transition;
        width: 1.5rem;
        height: 0.125rem;
    }
    .nav-toggle-icon:before,
    .nav-toggle-icon:after {
        @apply block absolute bg-current rounded transition-all;
        content: '';
        width: 1.5rem;
        height: 0.125rem;
    }
    .nav-toggle-icon:before {
        top: -0.5rem;
    }
    .nav-toggle-icon:after {
        top: 0.5rem;
    }
    .nav-toggle-icon.is-active {
        @apply bg-transparent;
    }
    .nav-toggle-icon.is-active:before {
        top: 0;
        margin-top: -0.5625rem;
        transform: translateY(0.5rem) rotate(-45deg);
    }
    .nav-toggle-icon.is-active:after {
        top: 0;
        margin-top: -0.5625rem;
        transform: translateY(0.5rem) rotate(45deg);
    }
</style>

<script>
    import { mountMobileNav } from '../scripts/mobile-nav';

    mountMobileNav();
    document.addEventListener('astro:after-swap', mountMobileNav);
</script>
