---
import { client as sanityClient } from '@utils/sanity-client';
import { POSTS_QUERY, type Post } from '@data/posts';

const allPosts = await sanityClient.fetch<Post[]>(POSTS_QUERY);
const posts = allPosts.slice(0, 12);
---

<main class="container mx-auto min-h-screen max-w-3xl p-8">
    <h1 class="text-4xl font-bold mb-8">Posts</h1>
    <ul class="flex flex-col gap-y-4">
        {
            posts.map((post) => (
                <li class="hover:underline">
                    <a href={`/posts/${post.slug.current}`}>
                        <h2 class="text-xl font-semibold">{post.title}</h2>
                        <p>{post.publishedAt ? new Date(post.publishedAt).toLocaleDateString() : ''}</p>
                    </a>
                </li>
            ))
        }
    </ul>
</main>
