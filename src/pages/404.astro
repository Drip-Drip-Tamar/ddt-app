---
import Layout from '@layouts/Layout.astro';

// This page has no editable Sanity content of its own; Layout still fetches
// siteConfig for the header/footer nav, so prerendering means nav labels can
// go stale between builds until the next deploy. Judged acceptable for a
// rarely-hit error page — worth revisiting if nav changes need to appear
// instantly everywhere.
export const prerender = true;
---

<Layout title="404 - Page Not Found">
    <div class="min-h-screen flex items-center justify-center">
        <div class="text-center p-8">
            <h1 class="text-6xl font-bold mb-4">404</h1>
            <h2 class="text-2xl font-semibold mb-4">Page Not Found</h2>
            <p class="text-lg mb-8">Sorry, the page you're looking for doesn't exist.</p>
            <div class="space-x-4">
                <a href="/" class="btn btn-primary">Go to Homepage</a>
                <a href="/results" class="btn btn-outline">View Results</a>
            </div>
        </div>
    </div>
</Layout>